#!/bin/sh
set -e
case "$1" in
  configure)
    mkdir -p /var/lib/schoolshield
    # Фильтр 18+ включается сразу при установке и обновляется при каждом обновлении пакета. Ошибка здесь не должна ломать установку.
    /usr/bin/schoolshield-teacher apply || echo "SchoolShield: фильтр 18+ не применён, повторите: sudo schoolshield-teacher apply" >&2
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true; fi
    if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q /usr/share/applications || true; fi
    ;;
esac
exit 0

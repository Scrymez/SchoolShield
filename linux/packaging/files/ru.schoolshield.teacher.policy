<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SchoolShield</vendor>
  <vendor_url>https://github.com/Scrymez/SchoolShield</vendor_url>
  <action id="ru.schoolshield.teacher.manage">
    <description>Управление фильтром 18+ (SchoolShield, редакция «Учитель»)</description>
    <message>Нужен пароль администратора, чтобы изменить фильтр 18+</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/schoolshield-teacher</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
